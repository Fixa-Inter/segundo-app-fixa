<?xml version="1.0" encoding="utf-8"?>
<!-- Rodapé dos passos: "Voltar" texto 400/20 preto @ x=55; botão 140x50 r=25 #153D7D com texto 400/20 branco -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStepBack"
        style="@style/Widget.FIXA.App.Button.Text"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/app_button_height_lg"
        android:layout_marginStart="@dimen/app_step_back_margin_start"
        android:fontFamily="@font/poppins_regular"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:text="@string/app_back"
        android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
        android:textColor="@color/app_text_black"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:rippleColor="@color/app_field_background" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStepNext"
        style="@style/Widget.FIXA.App.Button.Primary"
        android:layout_width="@dimen/app_button_step_width"
        android:layout_height="@dimen/app_button_height_lg"
        android:layout_marginEnd="@dimen/app_step_actions_side_margin"
        android:fontFamily="@font/poppins_regular"
        android:text="@string/app_next"
        android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
        android:textColor="@color/app_on_primary"
        android:textFontWeight="400"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Próximo" />
</androidx.constraintlayout.widget.ConstraintLayout>
