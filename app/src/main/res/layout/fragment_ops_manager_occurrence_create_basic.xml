<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ops_color_fff5f7fa" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="48dp" android:layout_marginEnd="24dp" android:text="Informações básicas" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="6dp" android:layout_marginEnd="24dp" android:text="Descreva a ocorrência." android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="32dp" android:paddingTop="24dp" android:paddingEnd="32dp" android:paddingBottom="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Título" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
            <EditText android:id="@+id/occurrenceCreateTitle" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp" android:background="@drawable/bg_app_field_soft" android:hint="Digite o título da ocorrência" android:inputType="textCapSentences" android:paddingHorizontal="16dp" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Field" android:textColor="@color/app_text_black" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Descrição" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
            <EditText android:id="@+id/occurrenceCreateDescription" android:layout_width="match_parent" android:layout_height="140dp" android:layout_marginTop="8dp" android:background="@drawable/bg_app_field_soft" android:gravity="top" android:hint="Descreva o problema encontrado" android:inputType="textCapSentences|textMultiLine" android:padding="16dp" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Field" android:textColor="@color/app_text_black" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ops_manager_home_card_side_margin" android:layout_marginEnd="@dimen/ops_manager_home_card_side_margin" android:layout_marginBottom="@dimen/ops_form_action_bottom_margin" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateCancel" style="@style/Widget.FIXA.App.Button.Text" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_weight="1" android:text="Cancelar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateNext" style="@style/Widget.FIXA.App.Button.Primary" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Próximo" />
    </LinearLayout>
</LinearLayout>
