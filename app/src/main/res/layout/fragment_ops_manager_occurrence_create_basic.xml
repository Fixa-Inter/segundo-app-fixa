<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/occurrenceCreateScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/occurrenceStepIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/occurrenceGuideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/app_step_label_margin_start" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/occurrenceGuideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/app_step_label_margin_start" />

            <TextView
                android:id="@+id/occurrenceCreateHeading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_step_title_margin_start"
                android:layout_marginTop="@dimen/app_step_title_margin_top"
                android:layout_marginEnd="@dimen/app_step_title_margin_start"
                android:text="@string/ops_occurrence_create_step_basic"
                android:textAppearance="@style/TextAppearance.FIXA.App.StepTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/occurrenceCreateTitleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_step_section_margin_top"
                android:text="Título"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Label"
                app:layout_constraintStart_toStartOf="@id/occurrenceGuideStart"
                app:layout_constraintTop_toBottomOf="@id/occurrenceCreateHeading" />

            <EditText
                android:id="@+id/occurrenceCreateTitle"
                android:layout_width="0dp"
                android:layout_height="@dimen/app_step_field_height"
                android:layout_marginTop="@dimen/app_step_field_margin_top"
                android:background="@drawable/bg_app_step_field"
                android:hint="Digite o título da ocorrência"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:paddingStart="@dimen/app_step_field_padding_start"
                android:paddingEnd="@dimen/app_step_field_padding_start"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Field"
                android:textColor="@color/app_text_black"
                android:textColorHint="@color/app_text_placeholder_dark"
                app:layout_constraintStart_toStartOf="@id/occurrenceGuideStart"
                app:layout_constraintEnd_toEndOf="@id/occurrenceGuideEnd"
                app:layout_constraintTop_toBottomOf="@id/occurrenceCreateTitleLabel" />

            <TextView
                android:id="@+id/occurrenceCreateDescriptionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_step_section_margin_top"
                android:text="Descrição"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Label"
                app:layout_constraintStart_toStartOf="@id/occurrenceGuideStart"
                app:layout_constraintTop_toBottomOf="@id/occurrenceCreateTitle" />

            <EditText
                android:id="@+id/occurrenceCreateDescription"
                android:layout_width="0dp"
                android:layout_height="@dimen/app_step_textarea_height"
                android:layout_marginTop="@dimen/app_step_field_margin_top"
                android:background="@drawable/bg_app_step_field"
                android:gravity="top|start"
                android:hint="Descreva o problema encontrado"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:paddingStart="@dimen/app_step_textarea_padding_start"
                android:paddingTop="@dimen/app_step_textarea_padding_top"
                android:paddingEnd="@dimen/app_step_textarea_padding_start"
                android:paddingBottom="@dimen/app_step_textarea_padding_top"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Field"
                android:textColor="@color/app_text_black"
                android:textColorHint="@color/app_text_placeholder_dark"
                app:layout_constraintStart_toStartOf="@id/occurrenceGuideStart"
                app:layout_constraintEnd_toEndOf="@id/occurrenceGuideEnd"
                app:layout_constraintTop_toBottomOf="@id/occurrenceCreateDescriptionLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/occurrenceStepIndicator"
        layout="@layout/view_ops_occurrence_progress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/app_occurrence_progress_footer_gap"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/occurrenceCreateFooter" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/occurrenceCreateFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/app_step_actions_margin_bottom"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceCreateCancel"
            style="@style/Widget.FIXA.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_button_height_lg"
            android:layout_marginStart="@dimen/app_step_back_margin_start"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/app_cancel"
            android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
            android:textColor="@color/app_text_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceCreateNext"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="@dimen/app_button_step_width"
            android:layout_height="@dimen/app_button_height_lg"
            android:layout_marginEnd="@dimen/app_step_actions_side_margin"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/app_next"
            android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
            android:textColor="@color/app_on_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
