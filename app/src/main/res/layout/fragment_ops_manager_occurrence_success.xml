<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".ui.view.operations.OperationsScreenFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/ops_5717_6066"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/app_request_success_image_margin_top"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:tag="image:image 172"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/app_success_image_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/app_success_image_size"
            app:layout_constraintWidth_percent="0.9"
            app:srcCompat="@drawable/img_success_illustration" />

        <TextView
            android:id="@+id/ops_5717_6067"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:tag="text:Ocorrência registrada com sucesso!"
            android:text="@string/ops_text_ocorrencia_registrada_com_sucesso_d438f5"
            android:textAppearance="@style/TextAppearance.FIXA.App.Success.Title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_6066" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ops_5717_6063"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_button_height"
            android:layout_marginStart="@dimen/app_success_button_side_margin"
            android:layout_marginTop="@dimen/app_success_button_margin_top"
            android:layout_marginEnd="@dimen/app_success_button_side_margin"
            android:background="@drawable/bg_app_button_pill"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_6067"
            app:layout_constraintWidth_max="346dp">

            <TextView
                android:id="@+id/ops_5717_6064"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:fontFamily="@font/poppins_medium"
                android:gravity="center"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:tag="text:Ir para a Home"
                android:text="@string/ops_text_ir_para_a_home_419580"
                android:textColor="@color/app_on_primary"
                android:textSize="@dimen/app_success_button_text_size"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/ops_5717_6065"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_button_height"
            android:layout_marginTop="@dimen/app_success_secondary_margin_top"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:tag="text:Registrar novo problema"
            android:text="@string/ops_text_registrar_novo_problema_6491d3"
            android:textColor="@color/app_primary_deep"
            android:textSize="@dimen/app_success_button_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_6063" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>