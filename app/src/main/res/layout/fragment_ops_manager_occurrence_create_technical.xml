<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ops_color_fff5f7fa" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="48dp" android:layout_marginEnd="24dp" android:text="Informações técnicas" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="6dp" android:layout_marginEnd="24dp" android:text="Classifique a ocorrência." android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="32dp" android:paddingTop="24dp" android:paddingEnd="32dp" android:paddingBottom="24dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Categoria do equipamento" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
            <include android:id="@+id/occurrenceCreateEquipment" layout="@layout/view_app_filter_dropdown" android:layout_width="match_parent" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Categoria do problema" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
            <include android:id="@+id/occurrenceCreateCategory" layout="@layout/view_app_filter_dropdown" android:layout_width="match_parent" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="8dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="Prioridade" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
            <include android:id="@+id/occurrenceCreatePriority" layout="@layout/view_app_filter_dropdown" android:layout_width="match_parent" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="8dp" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginEnd="32dp" android:layout_marginBottom="20dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateBack" style="@style/Widget.FIXA.App.Button.Text" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_weight="1" android:text="Voltar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateNext" style="@style/Widget.FIXA.App.Button.Primary" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Próximo" />
    </LinearLayout>
</LinearLayout>
