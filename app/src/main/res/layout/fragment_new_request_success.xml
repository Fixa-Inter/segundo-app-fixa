<?xml version="1.0" encoding="utf-8"?>
<!--
  Sucesso (Figma): ilustração 380dp @ top 77; título 500/30 #0B013C centralizado; botão "Ir para a Home" 346x45 r=25;
  "Registrar novo problema" texto 500/18 #153D7D.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true"
    tools:context=".ui.newrequest.NewRequestSuccessFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/app_success_image_margin_top"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHeight_max="@dimen/app_success_image_size"
            app:layout_constraintWidth_max="@dimen/app_success_image_size"
            app:layout_constraintWidth_percent="0.8"
            app:srcCompat="@drawable/img_success_illustration" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="30dp"
            android:gravity="center"
            android:text="@string/app_success_title"
            android:textAppearance="@style/TextAppearance.FIXA.App.Success.Title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSuccess" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoHome"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_button_height"
            android:layout_marginStart="@dimen/app_success_button_side_margin"
            android:layout_marginTop="@dimen/app_success_button_margin_top"
            android:layout_marginEnd="@dimen/app_success_button_side_margin"
            android:letterSpacing="-0.0178"
            android:text="@string/app_success_home"
            android:textSize="@dimen/app_success_button_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintWidth_max="346dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewRequest"
            style="@style/Widget.FIXA.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_button_height"
            android:layout_marginTop="@dimen/app_success_secondary_margin_top"
            android:letterSpacing="-0.0178"
            android:text="@string/app_success_new"
            android:textColor="@color/app_primary_deep"
            android:textSize="@dimen/app_success_button_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnGoHome"
            app:rippleColor="@color/app_field_background" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
