<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recoveryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background_alt"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.auth.PasswordSuccessActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/recovery_bottom_spacing">

        <ImageView
            android:id="@+id/ivSuccess"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/app_success_image_margin_top"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/app_success_image_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/app_success_image_size"
            app:layout_constraintWidth_percent="0.8"
            app:srcCompat="@drawable/img_success_illustration" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_success_button_side_margin"
            android:layout_marginTop="@dimen/recovery_success_title_top_margin"
            android:layout_marginEnd="@dimen/app_success_button_side_margin"
            android:accessibilityHeading="true"
            android:gravity="center"
            android:text="@string/recovery_success_title"
            android:textAppearance="@style/TextAppearance.FIXA.App.Success.Title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivSuccess" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackToLogin"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_success_button_side_margin"
            android:layout_marginTop="@dimen/app_success_button_margin_top"
            android:layout_marginEnd="@dimen/app_success_button_side_margin"
            android:minHeight="@dimen/app_button_height_lg"
            android:text="@string/recovery_success_back_to_login"
            android:textColor="@color/app_on_primary_soft"
            android:textSize="@dimen/app_success_button_text_size"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvTitle"
            app:layout_constraintWidth_max="346dp" />

        <!-- Figma 5079:5616: link "Registrar novo problema" 500/18 #0B013C abaixo do botão -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewRequest"
            style="@style/Widget.FIXA.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_button_height"
            android:layout_marginTop="@dimen/app_success_secondary_margin_top"
            android:letterSpacing="-0.0178"
            android:text="@string/app_success_new"
            android:textColor="@color/app_primary_deep"
            android:textSize="@dimen/app_success_button_text_size"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnBackToLogin"
            app:layout_constraintVertical_bias="0"
            app:rippleColor="@color/app_field_background" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
