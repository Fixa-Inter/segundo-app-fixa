<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ops_entry_gap"
    app:cardBackgroundColor="@color/app_surface" app:strokeWidth="0dp"
    app:cardCornerRadius="@dimen/ops_entry_radius" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/ops_entry_height" android:padding="@dimen/ops_entry_padding"
        android:orientation="vertical">
        <TextView android:id="@+id/opsEntryTitle" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.FIXA.App.Medium"
            android:textColor="@color/app_primary_dark" android:textSize="@dimen/ops_entry_title_size"/>
        <TextView android:id="@+id/opsEntryDescription" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:includeFontPadding="false"
            android:textAppearance="@style/TextAppearance.FIXA.App.Regular"
            android:textColor="@color/app_text_secondary" android:textSize="@dimen/ops_entry_body_size"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
