<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ops_d29971270c"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".ui.view.operations.OperationsScreenFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ops_dp_350">

        <TextView
            android:id="@+id/ops_5717_6053"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.6a9483c725"
            android:textColor="@color/app_primary"
            android:textSize="@dimen/ops_sp_30_0"
            android:maxLines="1"
            android:layout_marginTop="@dimen/ops_dp_39_0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/ops_5717_6055"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/ops_text_valor_antigo_490e8b"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.590d0b3c5b"
            android:textSize="@dimen/ops_sp_18_0"
            android:layout_marginStart="@dimen/ops_dp_48_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_6057"
            app:layout_constraintTop_toTopOf="@id/ops_5717_6057" />

        <EditText
            android:id="@+id/ops_5717_6057"
            android:layout_width="@dimen/ops_dp_80_0"
            android:layout_height="@dimen/ops_dp_40_0"
            android:background="@drawable/bg_app_dialog_field"
            android:enabled="false"
            android:focusable="false"
            android:gravity="center"
            android:inputType="numberDecimal|numberSigned"
            android:singleLine="true"
            android:tag="input:Valor antigo"
            android:text="_"
            android:textSize="@dimen/ops_sp_18_0"
            android:textColor="@color/app_text_black"
            android:layout_marginTop="@dimen/ops_dp_108_0"
            android:layout_marginEnd="@dimen/ops_dp_48_0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/ops_5717_6059"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/ops_text_novo_valor_487093"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.590d0b3c5b"
            android:textSize="@dimen/ops_sp_18_0"
            android:layout_marginStart="@dimen/ops_dp_48_0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_6051"
            app:layout_constraintTop_toTopOf="@id/ops_5717_6051" />

        <EditText
            android:id="@+id/ops_5717_6051"
            android:layout_width="@dimen/ops_dp_80_0"
            android:layout_height="@dimen/ops_dp_40_0"
            android:background="@drawable/bg_app_dialog_field"
            android:gravity="center"
            android:hint="9"
            android:inputType="numberDecimal|numberSigned"
            android:paddingHorizontal="8dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:tag="input:Novo valor"
            android:textSize="@dimen/ops_sp_18_0"
            android:textColor="@color/app_text_black"
            android:textColorHint="@color/app_text_secondary"
            android:fontFamily="@font/poppins_regular"
            android:layout_marginTop="@dimen/ops_dp_178_0"
            android:layout_marginEnd="@dimen/ops_dp_48_0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ops_5717_6050"
            android:layout_width="@dimen/ops_dp_115_0"
            android:layout_height="@dimen/ops_dp_35_0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="@dimen/ops_dp_48_0"
            android:layout_marginBottom="@dimen/ops_dp_50_0"
            android:background="@drawable/bg_ops_6fc7f4db18"
            android:tag="action:Cancelar"
            android:text="@string/ops_text_cancelar_bb9dbb"
            android:textAllCaps="false"
            android:textColor="@color/app_primary_deep"
            android:textSize="@dimen/ops_sp_14_0"
            android:fontFamily="@font/poppins_regular"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ops_5717_6049"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ops_5717_6049"
            android:layout_width="@dimen/ops_dp_115_0"
            android:layout_height="@dimen/ops_dp_35_0"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="@dimen/ops_dp_24_0"
            android:layout_marginEnd="@dimen/ops_dp_48_0"
            android:background="@drawable/bg_ops_ac8a55a5cb"
            android:tag="action:Salvar"
            android:text="@string/ops_text_salvar_aef7cd"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="@dimen/ops_sp_14_0"
            android:fontFamily="@font/poppins_regular"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_6050"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ops_5717_6050"
            app:layout_constraintTop_toTopOf="@id/ops_5717_6050" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
