<?xml version="1.0" encoding="utf-8"?>
<!--
  Chatbot (Figma): menu 24dp @ (32,39); título "Manu" 500/25 centralizado; avatar 130dp + balão 220x84 com saudação 400/16;
  caixa de entrada 380x130 r=30 (sombra #1A153D7D 0/2 blur 15) com hint 400/18, "+" 24dp, clipe 15x16 e enviar 30dp r=10 #130943.
  Menu lateral (230dp) em DrawerLayout.
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerChat"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.view.chatbot.ChatbotFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="@dimen/app_touch_target"
            android:layout_height="@dimen/app_touch_target"
            android:layout_marginStart="20dp"
            android:layout_marginTop="27dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_chat_open_menu"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_menu_24"
            app:tint="@color/app_primary_dark" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_chat_title"
            android:textAppearance="@style/TextAppearance.FIXA.App.Chat.Title"
            app:layout_constraintBottom_toBottomOf="@id/btnMenu"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnMenu" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMessages"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:visibility="gone"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toTopOf="@id/cardInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMenu"
            app:stackFromEnd="true" />

        <!-- Estado inicial -->
        <!-- Figma: avatar 130dp em x=11; balão 220x84 começa 10dp antes do fim do avatar e 20dp acima dele -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutGreeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@id/cardInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnMenu"
            app:layout_constraintHorizontal_bias="0.56"
            app:layout_constraintVertical_bias="0.42">

            <ImageView
                android:id="@+id/ivAssistant"
                android:layout_width="@dimen/app_chat_avatar_size"
                android:layout_height="@dimen/app_chat_avatar_size"
                android:layout_marginTop="@dimen/app_chat_bubble_offset_top"
                android:contentDescription="@string/app_chat_assistant_avatar"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/img_chatbot_avatar_hires" />

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="@dimen/app_chat_bubble_width"
                android:layout_height="@dimen/app_chat_bubble_height"
                android:layout_marginStart="@dimen/app_chat_bubble_overlap"
                android:background="@drawable/bg_app_chat_bubble"
                android:paddingStart="@dimen/app_chat_bubble_padding_start"
                android:paddingTop="@dimen/app_chat_bubble_padding_top"
                android:paddingEnd="@dimen/app_chat_bubble_padding_end"
                android:textAppearance="@style/TextAppearance.FIXA.App.Chat.Greeting"
                app:layout_constraintStart_toEndOf="@id/ivAssistant"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Olá Rapha, como posso te ajudar hoje?" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Caixa de entrada -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cardInput"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_chat_input_height"
            android:layout_marginStart="@dimen/app_chat_input_side_margin"
            android:layout_marginEnd="@dimen/app_chat_input_side_margin"
            android:layout_marginBottom="@dimen/app_chat_input_margin_bottom"
            android:background="@drawable/bg_app_chat_input"
            android:elevation="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <EditText
                android:id="@+id/etMessage"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@null"
                android:gravity="top|start"
                android:hint="@string/app_chat_input_hint"
                android:textColor="@color/app_text_black"
                android:textColorHint="@color/app_chat_input_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:paddingStart="@dimen/app_chat_input_padding_start"
                android:paddingTop="@dimen/app_chat_input_padding_top"
                android:paddingEnd="@dimen/app_chat_input_padding_start"
                android:textAppearance="@style/TextAppearance.FIXA.App.Chat.Input"
                app:layout_constraintBottom_toTopOf="@id/btnAttach"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnAttach"
                android:layout_width="@dimen/app_touch_target"
                android:layout_height="@dimen/app_touch_target"
                android:layout_marginStart="19dp"
                android:layout_marginBottom="10dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_chat_add"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:srcCompat="@drawable/ic_plus_24"
                app:tint="@color/app_primary_dark" />

            <!-- Figma: clipe 15x16 a 41dp do "+"; alvos de 48dp se sobrepõem nas bordas para manter a distância visual -->
            <ImageButton
                android:id="@+id/btnAttachFile"
                android:layout_width="@dimen/app_touch_target"
                android:layout_height="@dimen/app_touch_target"
                android:layout_marginStart="@dimen/app_chat_clip_margin_start"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_chat_attach"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="@id/btnAttach"
                app:layout_constraintStart_toEndOf="@id/btnAttach"
                app:layout_constraintTop_toTopOf="@id/btnAttach"
                app:srcCompat="@drawable/ic_paperclip_16" />

            <ImageButton
                android:id="@+id/btnSend"
                android:layout_width="@dimen/app_chat_send_size"
                android:layout_height="@dimen/app_chat_send_size"
                android:layout_marginEnd="@dimen/app_chat_send_margin_end"
                android:layout_marginBottom="@dimen/app_chat_action_margin_bottom"
                android:background="@drawable/bg_app_chat_send"
                android:contentDescription="@string/app_chat_send"
                android:scaleType="center"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:srcCompat="@drawable/ic_arrow_up_18"
                app:tint="@color/app_on_primary" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/drawerMenu"
        layout="@layout/view_app_chat_drawer"
        android:layout_width="@dimen/app_chat_drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start" />

</androidx.drawerlayout.widget.DrawerLayout>
