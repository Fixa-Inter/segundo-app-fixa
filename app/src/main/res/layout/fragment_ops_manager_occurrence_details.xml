<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    tools:context=".ui.view.operations.OperationsScreenFragment">

    <ImageButton
        android:id="@+id/ops_5717_9112"
        android:layout_width="@dimen/app_back_button_size"
        android:layout_height="@dimen/app_back_button_size"
        android:layout_marginStart="@dimen/app_back_button_margin_start"
        android:layout_marginTop="@dimen/app_back_button_margin_top"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_back"
        android:scaleType="center"
        android:tag="image:arrow-left"
        app:srcCompat="@drawable/ic_arrow_left_26"
        app:tint="@color/app_primary_deep"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/occurrenceDetailsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ops_5717_9112">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/ops_5717_9111"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_confirm_title_margin_start"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/app_confirm_title_margin_start"
                android:text="@string/ops_occurrence_details_title"
                android:textAppearance="@style/TextAppearance.FIXA.App.StepTitle"
                android:tag="text:Detalhes da ocorrência"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/ops_5717_9116"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_confirm_title_margin_start"
                android:layout_marginTop="@dimen/app_confirm_card_margin_top"
                android:layout_marginEnd="@dimen/app_confirm_title_margin_start"
                android:background="@android:color/transparent"
                android:padding="@dimen/app_confirm_card_padding"
                android:tag="card:Ar-condicionado quebrado"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ops_5717_9111"
                app:layout_constraintWidth_max="@dimen/app_content_max_width">

                <TextView
                    android:id="@+id/ops_5717_9117"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/ops_text_ar_condicionado_quebrado_d6029a"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Title"
                    android:tag="text:Ar-condicionado quebrado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/ops_5717_9118"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_card_body_margin_top"
                    android:text="@string/ops_text_o_ar_condicionado_estava_apresentando__a14433"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Body"
                    android:tag="text:O ar-condicionado estava apresentando vazamento e um ruído estranho até desligar completamente e não ligar mais."
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9117" />

                <TextView
                    android:id="@+id/ops_5717_9120"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_card_meta_margin_top"
                    android:text="@string/ops_text_aparelho_ar_condicionado_e63364"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Meta"
                    android:tag="text:Aparelho: Ar-Condicionado"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9118" />

                <TextView
                    android:id="@+id/ops_5717_9119"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_meta_spacing_vertical"
                    android:text="@string/ops_text_local_sala_s11_9bf398"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Meta"
                    android:tag="text:Local: Sala S11"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9120" />

                <TextView
                    android:id="@+id/ops_5717_9121"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_card_section_margin_top"
                    android:text="@string/ops_text_descricao_3bbd8f"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Meta"
                    android:tag="text:Descrição:"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9119" />

                <TextView
                    android:id="@+id/ops_5717_9123"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_card_body_margin_top"
                    android:text="@string/ops_text_sala_localizada_no_2_andar_no_corredor_a27b15"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Body"
                    android:tag="text:Sala localizada no 2° andar no corredor da esquerda subindo pela escada rolante, sala do meio do corredor onde fica o 2° Ano G."
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9121" />

                <TextView
                    android:id="@+id/ops_5717_9122"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/app_confirm_card_section_margin_top"
                    android:text="@string/ops_text_imagens_dfca0b"
                    android:textAppearance="@style/TextAppearance.FIXA.App.Confirm.Section"
                    android:tag="text:Imagens"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9123" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ops_5717_9124"
                    android:layout_width="@dimen/app_confirm_photo_size"
                    android:layout_height="@dimen/app_confirm_photo_size"
                    android:layout_marginTop="@dimen/app_confirm_card_images_margin_top"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no"
                    android:tag="image:"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ops_5717_9122"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.f1e42019ae" />

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/ops_5717_9125"
                    android:layout_width="@dimen/app_confirm_photo_size"
                    android:layout_height="@dimen/app_confirm_photo_size"
                    android:layout_marginStart="12dp"
                    android:scaleType="centerCrop"
                    android:importantForAccessibility="no"
                    android:tag="image:"
                    app:layout_constraintStart_toEndOf="@id/ops_5717_9124"
                    app:layout_constraintTop_toTopOf="@id/ops_5717_9124"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.f1e42019ae" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
