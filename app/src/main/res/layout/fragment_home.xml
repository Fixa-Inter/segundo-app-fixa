<?xml version="1.0" encoding="utf-8"?>
<!--
  Home (Figma 412x917): avatar 85dp @ (31,57); saudação Poppins 600 25 #0E223F;
  ícones bell/user no topo direito; card "Estados das solicitações" 350x240 r=20 sombra #0D153D7D blur 8;
  legenda 4 linhas (dot 16dp) + donut 190dp; seção "Minhas Solicitações" + botão 115x30 r=15;
  lista de cards 350x110. Conteúdo limitado a 412dp e centralizado em tablets.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollHome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/app_home_card_side_margin"
    tools:context=".ui.view.home.HomeFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/homeRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHomeMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/app_text_navy"
            android:textSize="16sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/app_home_card_side_margin" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/app_home_card_side_margin" />

        <!-- Header: ícones no tamanho exato, alinhados à guideline dos cards; área de toque expandida no Fragment -->
        <ImageView
            android:id="@+id/btnProfile"
            android:layout_width="@dimen/app_home_header_icon_size"
            android:layout_height="@dimen/app_home_header_icon_size"
            android:layout_marginTop="@dimen/app_home_header_margin_top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/app_home_profile"
            android:focusable="true"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_home_user_12"
            app:tint="@color/app_text_navy" />

        <ImageView
            android:id="@+id/btnNotifications"
            android:layout_width="@dimen/app_home_header_icon_size"
            android:layout_height="@dimen/app_home_header_icon_size"
            android:layout_marginEnd="@dimen/app_home_header_icon_spacing"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="@string/app_home_notifications"
            android:focusable="true"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@id/btnProfile"
            app:layout_constraintEnd_toStartOf="@id/btnProfile"
            app:layout_constraintTop_toTopOf="@id/btnProfile"
            app:srcCompat="@drawable/ic_home_bell_13"
            app:tint="@color/app_text_navy" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/ivAvatar"
            android:layout_width="@dimen/app_home_avatar_size"
            android:layout_height="@dimen/app_home_avatar_size"
            android:layout_marginStart="3dp"
            android:layout_marginTop="@dimen/app_home_avatar_margin_top"
            android:contentDescription="@string/app_user_avatar"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toTopOf="parent"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:srcCompat="@drawable/img_avatar_115" />

        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_home_greeting_margin_start"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.FIXA.App.Home.Greeting"
            app:layout_constraintBottom_toBottomOf="@id/ivAvatar"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar"
            tools:text="Olá, Ryan Cursino!" />

        <!-- Card estados -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_home_card_margin_top"
            app:cardBackgroundColor="@color/app_surface"
            app:cardCornerRadius="@dimen/app_home_card_radius"
            app:cardElevation="2dp"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/app_home_card_height"
                android:padding="@dimen/app_home_card_padding">

                <TextView
                    android:id="@+id/tvStatusTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/app_home_status_title"
                    android:textAppearance="@style/TextAppearance.FIXA.App.SectionTitle"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Legenda -->
                <LinearLayout
                    android:id="@+id/layoutLegend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/app_home_legend_margin_start"
                    android:layout_marginTop="@dimen/app_home_legend_margin_top"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvStatusTitle"
                    app:layout_constraintVertical_bias="0">

                    <include
                        android:id="@+id/legendDone"
                        layout="@layout/view_app_home_legend_row" />

                    <include
                        android:id="@+id/legendApproved"
                        layout="@layout/view_app_home_legend_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/app_home_legend_row_spacing" />

                    <include
                        android:id="@+id/legendAnalysis"
                        layout="@layout/view_app_home_legend_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/app_home_legend_row_spacing" />

                    <include
                        android:id="@+id/legendRefused"
                        layout="@layout/view_app_home_legend_row"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/app_home_legend_row_spacing" />
                </LinearLayout>

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/ivChart"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/app_home_chart_description"
                    android:scaleType="fitCenter"
                    app:layout_constraintBottom_toBottomOf="@id/layoutLegend"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHeight_max="@dimen/app_home_chart_size"
                    app:layout_constraintStart_toEndOf="@id/layoutLegend"
                    app:layout_constraintTop_toTopOf="@id/layoutLegend"
                    app:layout_constraintHorizontal_bias="1"
                    app:layout_constraintWidth_max="@dimen/app_home_chart_size"
                    />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Seção minhas solicitações: título centralizado verticalmente no botão "Abrir Solicitação" (Figma: ambos com centro em y=453) -->
        <TextView
            android:id="@+id/tvRequestsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_home_requests_title"
            android:textAppearance="@style/TextAppearance.FIXA.App.Home.SectionTitle"
            app:layout_constraintBottom_toBottomOf="@id/btnOpenRequest"
            app:layout_constraintEnd_toStartOf="@id/btnOpenRequest"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toTopOf="@id/btnOpenRequest" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenRequest"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_home_open_button_height"
            android:layout_marginTop="@dimen/app_home_section_margin_top"
            android:fontFamily="@font/poppins_medium"
            android:includeFontPadding="false"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:letterSpacing="0"
            android:minWidth="@dimen/app_home_open_button_width"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:text="@string/app_home_open_request"
            android:textAllCaps="false"
            android:textAppearance="@style/TextAppearance.FIXA.App.Home.OpenButton"
            android:textColor="@color/app_text_navy"
            app:backgroundTint="@color/app_surface"
            app:cornerRadius="15dp"
            app:elevation="2dp"
            app:icon="@drawable/ic_plus_24"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="@dimen/app_home_open_icon_size"
            app:iconTint="@color/app_text_navy"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintTop_toBottomOf="@id/cardStatus" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvHomeRequests"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/app_home_list_margin_top"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/btnOpenRequest"
            tools:itemCount="2"
            tools:listitem="@layout/item_app_request" />

        <LinearLayout
            android:id="@+id/layoutHomeRequestsEmpty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/btnOpenRequest">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:maxHeight="180dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                app:srcCompat="@drawable/img_empty_results" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_home_requests_empty"
                android:textAppearance="@style/TextAppearance.FIXA.App.EmptyTitle" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
