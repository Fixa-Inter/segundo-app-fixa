<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recoveryRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_surface"
    android:fillViewport="true"
    android:overScrollMode="never"
    tools:context=".ui.view.auth.ResetPasswordActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/recovery_bottom_spacing">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideStart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_begin="@dimen/recovery_side_margin" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideEnd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_end="@dimen/recovery_side_margin" />

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/app_touch_target"
            android:layout_height="@dimen/app_touch_target"
            android:layout_marginTop="@dimen/app_back_button_margin_top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_back"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_left_22"
            app:tint="@color/app_primary_deep" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recovery_title_top_margin"
            android:textAppearance="@style/TextAppearance.FIXA.App.Recovery.Title"
            android:accessibilityHeading="true"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintWidth_max="@dimen/recovery_reset_title_max_width"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="Defina uma nova senha" />

        <TextView
            android:id="@+id/tvPasswordLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recovery_label_inset"
            android:layout_marginTop="@dimen/recovery_reset_label_top_margin"
            android:labelFor="@id/etPassword"
            android:text="@string/recovery_password_label"
            android:textAppearance="@style/TextAppearance.FIXA.App.Recovery.Label"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/tvTitle" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recovery_field_top_margin"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_app_recovery_field"
            android:hint="@string/recovery_password_hint"
            android:imeOptions="actionNext"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="@dimen/recovery_field_height"
            android:paddingStart="@dimen/recovery_field_padding_horizontal"
            android:paddingEnd="@dimen/recovery_field_padding_horizontal"
            android:textAppearance="@style/TextAppearance.FIXA.App.Recovery.Field"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel" />

        <TextView
            android:id="@+id/tvConfirmLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/recovery_label_inset"
            android:layout_marginTop="@dimen/recovery_confirm_label_top_margin"
            android:labelFor="@id/etConfirmPassword"
            android:text="@string/recovery_confirm_password_label"
            android:textAppearance="@style/TextAppearance.FIXA.App.Recovery.Label"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/etPassword" />

        <EditText
            android:id="@+id/etConfirmPassword"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recovery_field_top_margin"
            android:autofillHints="newPassword"
            android:background="@drawable/bg_app_recovery_field"
            android:hint="@string/recovery_confirm_password_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:maxLines="1"
            android:minHeight="@dimen/recovery_field_height"
            android:paddingStart="@dimen/recovery_field_padding_horizontal"
            android:paddingEnd="@dimen/recovery_field_padding_horizontal"
            android:textAppearance="@style/TextAppearance.FIXA.App.Recovery.Field"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/tvConfirmLabel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirm"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/recovery_reset_button_top_margin"
            android:minHeight="@dimen/recovery_button_height"
            android:text="@string/recovery_confirm"
            android:textSize="@dimen/recovery_button_text_size"
            app:backgroundTint="@color/app_primary_dark"
            app:cornerRadius="@dimen/recovery_button_radius"
            app:layout_constraintEnd_toEndOf="@id/guideEnd"
            app:layout_constraintStart_toStartOf="@id/guideStart"
            app:layout_constraintTop_toBottomOf="@id/etConfirmPassword"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintVertical_bias="0" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
