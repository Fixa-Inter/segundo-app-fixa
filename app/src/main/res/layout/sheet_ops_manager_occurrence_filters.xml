        <TextView android:id="@+id/labelPeriod" style="@style/TextAppearance.FIXA.App.Filter.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_filter_label_margin_top" android:text="@string/app_filter_period" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/tvFilterTitle" />
        <include android:id="@+id/fieldPeriod" layout="@layout/view_app_filter_dropdown" android:layout_width="0dp" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="@dimen/app_filter_field_margin_top" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/labelPeriod" />
        <TextView android:id="@+id/labelAuthor" style="@style/TextAppearance.FIXA.App.Filter.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_filter_group_spacing" android:text="@string/app_filter_author" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/fieldPeriod" />
        <include android:id="@+id/fieldAuthor" layout="@layout/view_app_filter_dropdown" android:layout_width="0dp" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="@dimen/app_filter_field_margin_top" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/labelAuthor" />
        <TextView android:id="@+id/labelLocation" style="@style/TextAppearance.FIXA.App.Filter.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_filter_group_spacing" android:text="@string/app_filter_location" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/fieldAuthor" />
        <include android:id="@+id/fieldLocation" layout="@layout/view_app_filter_dropdown" android:layout_width="0dp" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="@dimen/app_filter_field_margin_top" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/labelLocation" />
