        <include android:id="@+id/fieldEquipment" layout="@layout/view_app_filter_dropdown" android:layout_width="0dp" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="@dimen/app_filter_field_margin_top" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/labelEquipment" />
        <TextView android:id="@+id/labelCategory" style="@style/TextAppearance.FIXA.App.Filter.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_filter_group_spacing" android:text="@string/ops_filter_problem_category" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/fieldEquipment" />
        <include android:id="@+id/fieldCategory" layout="@layout/view_app_filter_dropdown" android:layout_width="0dp" android:layout_height="@dimen/app_filter_field_height" android:layout_marginTop="@dimen/app_filter_field_margin_top" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" app:layout_constraintTop_toBottomOf="@id/labelCategory" />
        <TextView android:id="@+id/labelPriority" style="@style/TextAppearance.FIXA.App.Filter.Label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_filter_group_spacing" android:text="@string/ops_filter_priority" app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toBottomOf="@id/fieldCategory" />
