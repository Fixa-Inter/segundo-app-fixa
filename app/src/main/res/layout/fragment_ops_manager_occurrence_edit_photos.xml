<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/occurrenceEditPhotosScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/occurrenceEditPhotosFooter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/occurrenceEditGuideStart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/app_step_label_margin_start" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/occurrenceEditGuideEnd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/app_step_label_margin_start" />

            <TextView
                android:id="@+id/occurrenceEditPhotosTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/app_step_title_margin_start"
                android:layout_marginTop="@dimen/app_step_title_margin_top"
                android:layout_marginEnd="@dimen/app_step_title_margin_start"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/ops_occurrence_edit_photos_title"
                android:textAppearance="@style/TextAppearance.FIXA.App.StepTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/occurrenceEditPhotosLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/app_step_section_margin_top"
                android:text="Fotos"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Label"
                app:layout_constraintStart_toStartOf="@id/occurrenceEditGuideStart"
                app:layout_constraintTop_toBottomOf="@id/occurrenceEditPhotosTitle" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/occurrenceEditPhotosList"
                android:layout_width="0dp"
                android:layout_height="@dimen/app_step_upload_height"
                android:layout_marginTop="@dimen/app_step_field_margin_top"
                android:clipToPadding="false"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                app:layout_constraintEnd_toEndOf="@id/occurrenceEditGuideEnd"
                app:layout_constraintStart_toStartOf="@id/occurrenceEditGuideStart"
                app:layout_constraintTop_toBottomOf="@id/occurrenceEditPhotosLabel" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/occurrenceEditAddPhoto"
                style="@style/Widget.FIXA.App.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="@dimen/app_step_upload_camera_height"
                android:layout_marginTop="@dimen/app_step_upload_camera_margin_top"
                android:fontFamily="@font/poppins_regular"
                android:text="@string/ops_occurrence_add_photos"
                android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
                android:textColor="@color/app_on_primary"
                app:icon="@drawable/ic_image_upload"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/app_on_primary"
                app:layout_constraintEnd_toEndOf="@id/occurrenceEditGuideEnd"
                app:layout_constraintStart_toStartOf="@id/occurrenceEditGuideStart"
                app:layout_constraintTop_toBottomOf="@id/occurrenceEditPhotosList" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <ImageButton
        android:id="@+id/occurrenceEditPhotosBack"
        android:layout_width="@dimen/app_back_button_size"
        android:layout_height="@dimen/app_back_button_size"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_back"
        android:padding="12dp"
        android:src="@drawable/figma_eee40"
        android:scaleType="fitCenter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/occurrenceEditPhotosFooter"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/app_step_actions_margin_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceEditPhotosBackButton"
            style="@style/Widget.FIXA.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_button_height_lg"
            android:layout_marginStart="@dimen/app_step_back_margin_start"
            android:fontFamily="@font/poppins_regular"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:text="@string/app_back"
            android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
            android:textColor="@color/app_text_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceEditPhotosSave"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="@dimen/app_button_step_width"
            android:layout_height="@dimen/app_button_height_lg"
            android:layout_marginEnd="@dimen/app_step_actions_side_margin"
            android:fontFamily="@font/poppins_regular"
            android:text="@string/app_save"
            android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
            android:textColor="@color/app_on_primary"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
