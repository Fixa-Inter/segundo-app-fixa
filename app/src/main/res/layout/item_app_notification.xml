<?xml version="1.0" encoding="utf-8"?>
<!-- Ícone do tipo à esquerda e dot no canto superior direito apenas para notificações não lidas. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutNotification"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_notification_item_height"
    android:layout_marginBottom="@dimen/app_notification_item_spacing"
    android:background="@drawable/bg_app_notification_unread"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <View
        android:id="@+id/viewUnreadDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_app_notification_badge"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/ivNotificationType"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/app_primary_deep"
        tools:src="@drawable/ic_calendar_24" />

    <TextView
        android:id="@+id/tvNotificationText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="24dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.FIXA.App.Notification.Text"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/ivNotificationType"
        app:layout_goneMarginStart="16dp"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Sua solicitação foi aprovada!" />

    <TextView
        android:id="@+id/tvNotificationTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/app_notification_time_margin_end"
        android:layout_marginBottom="@dimen/app_notification_time_margin_bottom"
        android:textAppearance="@style/TextAppearance.FIXA.App.Notification.Time"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="09:41" />

</androidx.constraintlayout.widget.ConstraintLayout>
