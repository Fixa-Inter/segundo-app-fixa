<?xml version="1.0" encoding="utf-8"?>
<!-- Etapas do planejamento com o mesmo ritmo visual do passo a passo de solicitação. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:clipToPadding="false"
    android:fillViewport="true"
    tools:context=".ui.view.operations.OperationsScreenFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <ImageView
            android:id="@+id/ops_5717_8495"
            android:layout_width="@dimen/app_back_button_size"
            android:layout_height="@dimen/app_back_button_size"
            android:layout_marginStart="@dimen/app_back_button_margin_start"
            android:layout_marginTop="@dimen/app_back_button_margin_top"
            android:contentDescription="@string/app_back"
            android:scaleType="center"
            android:src="@drawable/ic_arrow_left_26"
            android:tag="image:arrow-left"
            app:tint="@color/app_primary_deep"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/ops_5717_8491"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_title_margin_start"
            android:layout_marginTop="@dimen/app_new_request_title_margin_top"
            android:layout_marginEnd="@dimen/app_new_request_title_margin_start"
            android:includeFontPadding="false"
            android:text="@string/ops_text_crie_todas_as_tarefas_da_os_e31e7a"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.Title"
            android:tag="text:Planeje a OS"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ops_5717_8486"
            android:layout_width="@dimen/app_new_request_step_circle_size"
            android:layout_height="@dimen/app_new_request_step_circle_size"
            android:layout_marginStart="@dimen/app_new_request_title_margin_start"
            android:layout_marginTop="@dimen/app_new_request_steps_margin_top"
            android:background="@drawable/bg_app_circle_primary"
            android:importantForAccessibility="no"
            android:src="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_8491" />

        <TextView
            android:id="@+id/ops_5717_8489"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="1"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_8486"
            app:layout_constraintEnd_toEndOf="@id/ops_5717_8486"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8486"
            app:layout_constraintTop_toTopOf="@id/ops_5717_8486" />

        <TextView
            android:id="@+id/ops_5717_8481"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_step_text_margin_start"
            android:includeFontPadding="false"
            android:text="@string/ops_text_passo_1_3a2db3"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel"
            android:tag="text:Passo 1"
            app:layout_constraintBottom_toTopOf="@id/ops_5717_8482"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ops_5717_8486"
            app:layout_constraintTop_toTopOf="@id/ops_5717_8486"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/ops_5717_8482"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/app_new_request_title_margin_start"
            android:includeFontPadding="false"
            android:text="@string/ops_text_informacoes_basicas_c1e6ae"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle"
            android:tag="text:Informações básicas"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_8486"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8481"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_8481" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ops_manager_planning_barrier_step_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ops_5717_8486,ops_5717_8482" />

        <View
            android:id="@+id/ops_5717_8488"
            android:layout_width="@dimen/app_new_request_step_line_width"
            android:layout_height="@dimen/app_new_request_step_line_height"
            android:layout_marginTop="@dimen/app_new_request_step_line_margin_top"
            android:background="@drawable/bg_app_step_line"
            app:layout_constraintEnd_toEndOf="@id/ops_5717_8486"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8486"
            app:layout_constraintTop_toBottomOf="@id/ops_manager_planning_barrier_step_1" />

        <ImageView
            android:id="@+id/ops_5717_8487"
            android:layout_width="@dimen/app_new_request_step_circle_size"
            android:layout_height="@dimen/app_new_request_step_circle_size"
            android:layout_marginTop="23dp"
            android:background="@drawable/bg_app_circle_primary"
            android:importantForAccessibility="no"
            android:src="@null"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8486"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_8488" />

        <TextView
            android:id="@+id/ops_5717_8490"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="2"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_8487"
            app:layout_constraintEnd_toEndOf="@id/ops_5717_8487"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8487"
            app:layout_constraintTop_toTopOf="@id/ops_5717_8487" />

        <TextView
            android:id="@+id/ops_5717_8483"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_step_text_margin_start"
            android:includeFontPadding="false"
            android:text="@string/ops_text_passo_2_089d44"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel"
            android:tag="text:Passo 2"
            app:layout_constraintBottom_toTopOf="@id/ops_5717_8484"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ops_5717_8487"
            app:layout_constraintTop_toTopOf="@id/ops_5717_8487"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/ops_5717_8484"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/ops_text_tarefas_relacionadas_a_os_edeff1"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle"
            android:tag="text:Tarefas relacionadas a OS"
            app:layout_constraintBottom_toBottomOf="@id/ops_5717_8487"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8483"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_8483" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ops_manager_planning_barrier_step_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ops_5717_8487,ops_5717_8484" />

        <View
            android:id="@+id/ops_manager_planning_step_connector_2"
            android:layout_width="@dimen/app_new_request_step_line_width"
            android:layout_height="@dimen/app_new_request_step_line_height"
            android:layout_marginTop="21dp"
            android:background="@drawable/bg_app_step_line"
            app:layout_constraintEnd_toEndOf="@id/ops_5717_8486"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8486"
            app:layout_constraintTop_toBottomOf="@id/ops_manager_planning_barrier_step_2" />

        <ImageView
            android:id="@+id/ops_manager_planning_step_3_circle"
            android:layout_width="@dimen/app_new_request_step_circle_size"
            android:layout_height="@dimen/app_new_request_step_circle_size"
            android:layout_marginTop="15dp"
            android:background="@drawable/bg_app_circle_primary"
            android:importantForAccessibility="no"
            android:src="@null"
            app:layout_constraintStart_toStartOf="@id/ops_5717_8486"
            app:layout_constraintTop_toBottomOf="@id/ops_manager_planning_step_connector_2" />

        <TextView
            android:id="@+id/ops_manager_planning_step_3_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="3"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber"
            app:layout_constraintBottom_toBottomOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintEnd_toEndOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintStart_toStartOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintTop_toTopOf="@id/ops_manager_planning_step_3_circle" />

        <TextView
            android:id="@+id/ops_manager_planning_step_3_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_step_text_margin_start"
            android:includeFontPadding="false"
            android:text="@string/ops_text_passo_3_c5724f"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel"
            android:tag="text:Passo 3"
            app:layout_constraintBottom_toTopOf="@id/ops_manager_planning_step_3_title"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintTop_toTopOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintVertical_bias="0" />

        <TextView
            android:id="@+id/ops_manager_planning_step_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="@string/ops_planning_assign_technician"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle"
            android:layout_marginEnd="@dimen/app_new_request_title_margin_start"
            android:tag="text:Atribuição"
            app:layout_constraintBottom_toBottomOf="@id/ops_manager_planning_step_3_circle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ops_manager_planning_step_3_label"
            app:layout_constraintTop_toBottomOf="@id/ops_manager_planning_step_3_label" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/ops_manager_planning_barrier_step_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="ops_manager_planning_step_3_circle,ops_manager_planning_step_3_title" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ops_5717_8492"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_new_request_continue_height"
            android:layout_marginStart="@dimen/app_step_label_margin_start"
            android:layout_marginTop="@dimen/app_new_request_continue_margin_top"
            android:layout_marginEnd="@dimen/app_step_label_margin_start"
            android:background="@drawable/bg_ops_e9ff3d87c6"
            android:gravity="center"
            android:includeFontPadding="false"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="@string/ops_text_continuar_63e2bb"
            android:textColor="@color/app_on_primary"
            android:textAllCaps="false"
            android:textSize="@dimen/app_new_request_continue_text_size"
            android:fontFamily="@font/poppins_medium"
            android:tag="action:Continuar"
            app:backgroundTint="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_manager_planning_barrier_step_3" />

        <TextView
            android:id="@+id/ops_5717_8494"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_new_request_cancel_height"
            android:layout_marginTop="@dimen/app_new_request_cancel_margin_top"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/ops_text_cancelar_bb9dbb"
            android:textAppearance="@style/TextAppearance.FIXA.App.Step.Action"
            android:textColor="@color/app_primary_deep"
            android:tag="text:Cancelar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_8492" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
