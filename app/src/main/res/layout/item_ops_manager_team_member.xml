<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ops_team_card_height"
    android:layout_marginBottom="@dimen/ops_team_card_spacing"
    android:background="@drawable/bg_ops_e04d888c51"
    android:elevation="1.5dp"
    android:outlineSpotShadowColor="@color/app_shadow_soft"
    android:outlineAmbientShadowColor="@color/app_shadow_soft">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/teamTechnicianAvatar"
        android:layout_width="@dimen/ops_team_avatar_size"
        android:layout_height="@dimen/ops_team_avatar_size"
        android:layout_marginStart="@dimen/ops_team_avatar_start"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avatar_115"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.TeamAvatar" />

    <TextView
        android:id="@+id/teamTechnicianName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/ops_team_meta_gap"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff0b013c"
        android:textSize="@dimen/ops_team_name_text_size"
        app:layout_constraintStart_toEndOf="@id/teamTechnicianAvatar"
        app:layout_constraintEnd_toStartOf="@id/teamTechnicianShiftHours"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/teamTechnicianAccess"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/teamTechnicianAccess"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/ops_team_meta_gap"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_access_text_size"
        app:layout_constraintStart_toEndOf="@id/teamTechnicianAvatar"
        app:layout_constraintEnd_toStartOf="@id/teamTechnicianShiftHours"
        app:layout_constraintTop_toBottomOf="@id/teamTechnicianName"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/teamTechnicianShiftIcon"
        android:layout_width="@dimen/ops_team_icon_size"
        android:layout_height="@dimen/ops_team_icon_size"
        android:layout_marginTop="@dimen/ops_team_meta_top"
        android:importantForAccessibility="no"
        android:src="@drawable/figma_7c18e"
        app:layout_constraintStart_toStartOf="@id/teamTechnicianShiftHours"
        app:layout_constraintEnd_toEndOf="@id/teamTechnicianShiftHours"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/teamTechnicianShiftHours"
        android:layout_width="@dimen/ops_team_shift_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_shift_competence_gap"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="@dimen/ops_team_meta_text_size"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/ops_color_ff000000"
        android:textSize="@dimen/ops_team_meta_text_size"
        app:layout_constraintEnd_toStartOf="@id/teamTechnicianCompetence"
        app:layout_constraintTop_toBottomOf="@id/teamTechnicianShiftIcon" />

    <TextView
        android:id="@+id/teamTechnicianShift"
        android:layout_width="@dimen/ops_team_shift_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_shift_competence_gap"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_meta_label_text_size"
        app:layout_constraintEnd_toStartOf="@id/teamTechnicianCompetence"
        app:layout_constraintTop_toBottomOf="@id/teamTechnicianShiftHours" />

    <ImageView
        android:id="@+id/teamTechnicianCompetenceIcon"
        android:layout_width="@dimen/ops_team_icon_size"
        android:layout_height="@dimen/ops_team_icon_size"
        android:layout_marginTop="@dimen/ops_team_meta_top"
        android:importantForAccessibility="no"
        android:src="@drawable/figma_57fba"
        app:layout_constraintStart_toStartOf="@id/teamTechnicianCompetence"
        app:layout_constraintEnd_toEndOf="@id/teamTechnicianCompetence"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/teamTechnicianCompetence"
        android:layout_width="@dimen/ops_team_specialty_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_meta_end"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff000000"
        android:textSize="@dimen/ops_team_meta_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teamTechnicianCompetenceIcon" />

    <TextView
        android:id="@+id/teamTechnicianCompetenceLabel"
        android:layout_width="@dimen/ops_team_specialty_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_meta_end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Área"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_meta_label_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/teamTechnicianCompetence" />
</androidx.constraintlayout.widget.ConstraintLayout>
