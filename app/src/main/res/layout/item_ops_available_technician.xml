<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/availableTechnicianCard"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_marginBottom="14dp"
    android:background="@drawable/bg_ops_e04d888c51"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="2dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/technicianAvatar"
        android:layout_width="55dp"
        android:layout_height="55dp"
        android:layout_marginStart="11dp"
        android:layout_marginTop="20dp"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avatar_115"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.d978b6fd23" />

    <TextView
        android:id="@+id/technicianName"
        android:layout_width="126dp"
        android:layout_height="27dp"
        android:layout_marginStart="78dp"
        android:layout_marginTop="21dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff0b013c"
        android:textSize="16sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/technicianRole"
        android:layout_width="69dp"
        android:layout_height="15dp"
        android:layout_marginStart="78dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Técnico"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/technicianName" />

    <TextView
        android:id="@+id/technicianRecommended"
        android:layout_width="96dp"
        android:layout_height="15dp"
        android:layout_marginStart="73dp"
        android:layout_marginTop="1dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Recomendado"
        android:textColor="@color/ops_color_ff1d9954"
        android:textSize="10sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/technicianRole" />

    <ImageView
        android:id="@+id/technicianClock"
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:layout_marginStart="228dp"
        android:layout_marginTop="28dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/figma_7c18e"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/technicianTasks"
        android:layout_width="42dp"
        android:layout_height="14dp"
        android:layout_marginStart="214dp"
        android:layout_marginTop="46dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff202020"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/technicianWorkLabel"
        android:layout_width="71dp"
        android:layout_height="11dp"
        android:layout_marginStart="199dp"
        android:layout_marginTop="59dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Em andamento"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/technicianCompetenceIcon"
        android:layout_width="11dp"
        android:layout_height="16dp"
        android:layout_marginStart="294dp"
        android:layout_marginTop="28dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_ops_competence_award"
        android:scaleType="fitXY"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/technicianCompetenceCategory"
        android:layout_width="54dp"
        android:layout_height="14dp"
        android:layout_marginStart="274dp"
        android:layout_marginTop="45dp"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff202020"
        android:textSize="10sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/technicianCompetenceScore"
        android:layout_width="54dp"
        android:layout_height="11dp"
        android:layout_marginStart="274dp"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="9sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/technicianCompetenceCategory" />

</androidx.constraintlayout.widget.ConstraintLayout>
