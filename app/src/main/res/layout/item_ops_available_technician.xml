<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/availableTechnicianCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/ops_team_card_height"
    android:layout_marginBottom="@dimen/ops_team_card_spacing"
    android:background="@drawable/bg_ops_e04d888c51"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="1.5dp"
    android:outlineAmbientShadowColor="@color/app_shadow_soft"
    android:outlineSpotShadowColor="@color/app_shadow_soft">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/technicianAvatar"
        android:layout_width="@dimen/ops_team_avatar_size"
        android:layout_height="@dimen/ops_team_avatar_size"
        android:layout_marginStart="@dimen/ops_team_avatar_start"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        android:src="@drawable/img_avatar_115"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.TeamAvatar" />

    <TextView
        android:id="@+id/technicianName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/ops_team_meta_gap"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff0b013c"
        android:textSize="@dimen/ops_team_name_text_size"
        app:layout_constraintBottom_toTopOf="@id/technicianRole"
        app:layout_constraintEnd_toStartOf="@id/technicianTasks"
        app:layout_constraintStart_toEndOf="@id/technicianAvatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/technicianRole"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/ops_team_meta_gap"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Técnico"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_access_text_size"
        app:layout_constraintBottom_toTopOf="@id/technicianRecommended"
        app:layout_constraintEnd_toStartOf="@id/technicianTasks"
        app:layout_constraintStart_toEndOf="@id/technicianAvatar"
        app:layout_constraintTop_toBottomOf="@id/technicianName" />

    <TextView
        android:id="@+id/technicianRecommended"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="@dimen/ops_team_meta_gap"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="Recomendado"
        android:textColor="@color/ops_color_ff1d9954"
        android:textSize="@dimen/ops_team_meta_label_text_size"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/technicianTasks"
        app:layout_constraintStart_toEndOf="@id/technicianAvatar"
        app:layout_constraintTop_toBottomOf="@id/technicianRole" />

    <ImageView
        android:id="@+id/technicianClock"
        android:layout_width="@dimen/ops_team_icon_size"
        android:layout_height="@dimen/ops_team_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/figma_7c18e"
        app:layout_constraintEnd_toEndOf="@id/technicianTasks"
        app:layout_constraintStart_toStartOf="@id/technicianTasks"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/technicianTasks"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/app_primary_deep" />

    <TextView
        android:id="@+id/technicianTasks"
        android:layout_width="@dimen/ops_team_shift_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_shift_competence_gap"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="@dimen/ops_team_meta_text_size"
        android:autoSizeStepGranularity="1sp"
        android:textColor="@color/ops_color_ff000000"
        android:textSize="@dimen/ops_team_meta_text_size"
        app:layout_constraintEnd_toStartOf="@id/technicianCompetenceCategory"
        app:layout_constraintTop_toBottomOf="@id/technicianClock"
        app:layout_constraintBottom_toTopOf="@id/technicianWorkLabel" />

    <TextView
        android:id="@+id/technicianWorkLabel"
        android:layout_width="@dimen/ops_team_shift_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_shift_competence_gap"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:ellipsize="end"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="9sp"
        android:autoSizeMaxTextSize="@dimen/ops_team_meta_label_text_size"
        android:autoSizeStepGranularity="1sp"
        android:text="Em andamento"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_meta_label_text_size"
        app:layout_constraintEnd_toStartOf="@id/technicianCompetenceCategory"
        app:layout_constraintTop_toBottomOf="@id/technicianTasks"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ImageView
        android:id="@+id/technicianCompetenceIcon"
        android:layout_width="@dimen/ops_team_icon_size"
        android:layout_height="@dimen/ops_team_icon_size"
        android:importantForAccessibility="no"
        android:src="@drawable/figma_57fba"
        app:layout_constraintEnd_toEndOf="@id/technicianCompetenceCategory"
        app:layout_constraintStart_toStartOf="@id/technicianCompetenceCategory"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/technicianCompetenceCategory"
        app:layout_constraintVertical_chainStyle="packed"
        app:tint="@color/app_primary_deep" />

    <TextView
        android:id="@+id/technicianCompetenceCategory"
        android:layout_width="@dimen/ops_team_specialty_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_meta_end"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff000000"
        android:textSize="@dimen/ops_team_meta_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/technicianCompetenceIcon"
        app:layout_constraintBottom_toTopOf="@id/technicianCompetenceScore" />

    <TextView
        android:id="@+id/technicianCompetenceScore"
        android:layout_width="@dimen/ops_team_specialty_width"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ops_team_meta_end"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/ops_color_ff8a93a2"
        android:textSize="@dimen/ops_team_meta_label_text_size"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/technicianCompetenceCategory"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
