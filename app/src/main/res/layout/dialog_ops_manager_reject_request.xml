<?xml version="1.0" encoding="utf-8"?>
<!-- Figma 5717:7093 • manager / reject_request. Componentes nativos; dimensões em values e sw400dp. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_ops_b18732bb6c"
    android:fillViewport="true"
    android:clipToPadding="false"
    tools:context=".ui.view.operations.OperationsScreenFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="340dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <ImageView
            android:id="@+id/ops_5717_7102"
            android:layout_width="112dp"
            android:layout_height="82dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/figma_c2ba1"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/ops_5717_7094"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="20dp"
            android:text="@string/ops_text_recusar_solicitacao_d1e1e7"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.958cd417e0"
            android:textSize="19sp"
            android:includeFontPadding="false"
            android:gravity="center"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_7102"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/ops_5717_7098"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="30dp"
            android:layout_marginTop="14dp"
            android:text="@string/ops_text_motivo_opcional_9691da"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.bfa9f8bfec"
            android:textSize="15sp"
            android:includeFontPadding="false"
            android:gravity="center_vertical"
            android:fontFamily="@font/poppins_medium"
            android:maxLines="1"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_7094"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatEditText
            android:id="@+id/ops_5717_7097"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="28dp"
            android:background="@drawable/bg_ops_6fc7f4db18"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.64d8355dbd"
            android:textSize="14sp"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:gravity="start|center_vertical"
            android:hint="@string/ops_text_informe_aqui_o_motivo_e2e774"
            android:inputType="textCapSentences"
            android:importantForAutofill="no"
            android:tag="field:Motivo(opcional)"
            app:layout_constraintTop_toBottomOf="@id/ops_5717_7098"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" android:textColor="@color/app_text_black" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ops_5717_7096"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="6dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_ops_6fc7f4db18"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ops_5717_7095"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/ops_5717_7100"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="@string/ops_text_cancelar_bb9dbb"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.be6ece948a"
                android:textSize="16sp"
                android:includeFontPadding="false"
                android:gravity="center"
                android:fontFamily="@font/poppins_regular"
                android:maxLines="1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/ops_5717_7095"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="28dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_ops_ac8a55a5cb"
            android:textAppearance="@style/TextAppearance.FIXA.Operations.1ad84ad5b4"
            android:textSize="16sp"
            android:gravity="center"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="@string/ops_text_recusar_ce4328"
            android:textAllCaps="false"
            android:tag="action:Recusar"
            app:backgroundTint="@null"
            app:layout_constraintStart_toEndOf="@id/ops_5717_7096"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
