<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ops_color_fff5f7fa" android:orientation="vertical">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="48dp" android:layout_marginEnd="24dp" android:text="Fotos da ocorrência" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Title" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="32dp" android:layout_marginTop="6dp" android:layout_marginEnd="24dp" android:text="Adicione até 3 fotos para ajudar na identificação." android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical" android:paddingStart="32dp" android:paddingTop="36dp" android:paddingEnd="32dp">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/occurrenceCreatePhotosList" android:layout_width="match_parent" android:layout_height="140dp" android:clipToPadding="false" android:paddingStart="4dp" android:paddingEnd="4dp" />
        <TextView android:id="@+id/occurrenceCreatePhotosCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Nenhuma foto adicionada" android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Label" />
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateAddPhotos" style="@style/Widget.FIXA.App.Button.Text" android:layout_width="match_parent" android:layout_height="@dimen/app_filter_apply_height" android:layout_marginTop="24dp" android:text="Adicionar fotos" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="@dimen/ops_manager_home_card_side_margin" android:layout_marginEnd="@dimen/ops_manager_home_card_side_margin" android:layout_marginBottom="@dimen/ops_form_action_bottom_margin" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateBack" style="@style/Widget.FIXA.App.Button.Text" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_weight="1" android:text="Voltar" />
        <com.google.android.material.button.MaterialButton android:id="@+id/occurrenceCreateFinish" style="@style/Widget.FIXA.App.Button.Primary" android:layout_width="0dp" android:layout_height="@dimen/app_filter_apply_height" android:layout_marginStart="12dp" android:layout_weight="1" android:text="Registrar" />
    </LinearLayout>
</LinearLayout>
