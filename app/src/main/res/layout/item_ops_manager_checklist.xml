<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/checklistCardRoot"
    android:layout_width="match_parent"
    android:layout_height="150dp"
    android:background="@drawable/bg_ops_e04d888c51"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/ops_dp_2">

    <View
        android:id="@+id/checklistCardAccent"
        android:layout_width="@dimen/ops_dp_20_0"
        android:layout_height="0dp"
        android:background="@drawable/bg_ops_b5e61ffcb6"
        android:elevation="@dimen/ops_dp_2"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/checklistCardMenu"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginTop="23dp"
        android:layout_marginEnd="10dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_more_options"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_more_vertical_14"
        android:tint="@color/ops_color_ff0b013c"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/checklistCardTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/ops_dp_30"
        android:layout_marginStart="@dimen/ops_dp_43_0"
        android:layout_marginTop="@dimen/ops_dp_23_0"
        android:layout_marginEnd="@dimen/ops_dp_45_0"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FIXA.Operations.ed72944a40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/checklistCardCategory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ops_dp_43_0"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="@dimen/ops_dp_12"
        android:ellipsize="end"
        android:fontFamily="@font/poppins_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FIXA.Operations.1be11be0ba"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/checklistCardTitle" />

    <LinearLayout
        android:id="@+id/checklistCardMetrics"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ops_dp_43_0"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="12dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/checklistCardCategory">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/checklistCardPeriodLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Periodicidade"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.170a20c38b"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/checklistCardPeriod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.8aeedd4985"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/checklistCardStatusLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Status"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.170a20c38b"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/checklistCardStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.8aeedd4985"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <TextView
                android:id="@+id/checklistCardModelsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Modelos"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.a2f03f1fa3"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/checklistCardModels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.FIXA.Operations.8aeedd4985"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
