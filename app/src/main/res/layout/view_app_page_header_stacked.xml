<?xml version="1.0" encoding="utf-8"?>
<!--
  Header com título abaixo da seta (Figma: FAQ, Sobre o app e Configurações): back 22dp @ (11,22);
  título 500/25 #130943 @ (41,51). Em Config o texto está centralizado numa caixa de 240dp em x=11,
  o que também o coloca visualmente em x≈41.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="0dp">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="@dimen/app_back_button_size"
        android:layout_height="@dimen/app_back_button_size"
        android:layout_marginStart="@dimen/app_back_button_margin_start"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_back"
        android:scaleType="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_arrow_left_26"
        app:tint="@color/app_primary_deep" android:layout_marginTop="@dimen/app_back_button_margin_top" />

    <TextView
        android:id="@+id/tvPageTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/app_screen_side_margin"
        android:layout_marginTop="@dimen/app_page_header_stacked_title_offset"
        android:layout_marginEnd="@dimen/app_screen_side_margin"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FIXA.App.PageTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        tools:text="FAQ" />
</androidx.constraintlayout.widget.ConstraintLayout>
