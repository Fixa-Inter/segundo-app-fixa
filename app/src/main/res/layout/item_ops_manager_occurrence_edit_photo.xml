<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="122dp"
    android:layout_height="122dp"
    android:layout_marginEnd="10dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/occurrenceEditPhotoImage"
        android:layout_width="112dp"
        android:layout_height="112dp"
        android:layout_gravity="bottom|start"
        android:contentDescription="@string/ops_occurrence_photo_description"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.FIXA.Operations.f1e42019ae" />

    <TextView
        android:id="@+id/occurrenceEditPhotoRemove"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:background="@drawable/bg_ops_occurrence_photo_remove"
        android:contentDescription="@string/ops_occurrence_remove_photo"
        android:gravity="center"
        android:text="×"
        android:textColor="@android:color/white"
        android:textSize="16sp" />
</FrameLayout>
