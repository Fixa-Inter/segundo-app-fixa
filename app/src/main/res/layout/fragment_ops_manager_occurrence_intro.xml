<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="48dp">

        <ImageButton
            android:id="@+id/occurrenceIntroBack"
            android:layout_width="@dimen/app_back_button_size"
            android:layout_height="@dimen/app_back_button_size"
            android:layout_marginStart="@dimen/app_back_button_margin_start"
            android:layout_marginTop="@dimen/app_back_button_margin_top"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/app_back"
            android:scaleType="center"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_left_26"
            app:tint="@color/app_primary_deep" />

        <TextView
            android:id="@+id/occurrenceIntroTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_title_margin_start"
            android:layout_marginTop="@dimen/app_new_request_title_margin_top"
            android:layout_marginEnd="@dimen/app_new_request_title_margin_start"
            android:text="@string/ops_occurrence_start_title"
            android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.Title"
            android:textColor="@color/app_primary"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/occurrenceIntroSteps"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_new_request_title_margin_start"
            android:layout_marginTop="@dimen/app_new_request_steps_margin_top"
            android:layout_marginEnd="@dimen/app_step_label_margin_start"
            android:orientation="vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/occurrenceIntroTitle">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_new_request_step_circle_size" android:background="@drawable/bg_app_circle_primary" android:gravity="center" android:includeFontPadding="false" android:text="1" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/app_new_request_step_text_margin_start" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_new_request_step_1" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ops_occurrence_start_basic" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_occurrence_intro_connector_height">
                <View android:layout_width="@dimen/app_new_request_step_line_width" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:background="@drawable/bg_app_step_line" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_occurrence_intro_step_gap" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_new_request_step_circle_size" android:background="@drawable/bg_app_circle_primary" android:gravity="center" android:includeFontPadding="false" android:text="2" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/app_new_request_step_text_margin_start" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_new_request_step_2" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ops_occurrence_start_location" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_occurrence_intro_connector_height">
                <View android:layout_width="@dimen/app_new_request_step_line_width" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:background="@drawable/bg_app_step_line" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_occurrence_intro_step_gap" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_new_request_step_circle_size" android:background="@drawable/bg_app_circle_primary" android:gravity="center" android:includeFontPadding="false" android:text="3" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/app_new_request_step_text_margin_start" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_new_request_step_3" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ops_occurrence_start_technical" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle" />
                </LinearLayout>
            </LinearLayout>
            <FrameLayout android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_occurrence_intro_connector_height">
                <View android:layout_width="@dimen/app_new_request_step_line_width" android:layout_height="match_parent" android:layout_gravity="center_horizontal" android:background="@drawable/bg_app_step_line" />
            </FrameLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="@dimen/app_occurrence_intro_step_gap" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:layout_width="@dimen/app_new_request_step_circle_size" android:layout_height="@dimen/app_new_request_step_circle_size" android:background="@drawable/bg_app_circle_primary" android:gravity="center" android:includeFontPadding="false" android:text="4" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepNumber" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="@dimen/app_new_request_step_text_margin_start" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ops_occurrence_step_4" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepLabel" />
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/ops_occurrence_start_photos" android:textAppearance="@style/TextAppearance.FIXA.App.NewRequest.StepTitle" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceIntroContinue"
            style="@style/Widget.FIXA.App.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_new_request_continue_height"
            android:layout_marginStart="@dimen/app_step_label_margin_start"
            android:layout_marginTop="@dimen/app_new_request_continue_margin_top"
            android:layout_marginEnd="@dimen/app_step_label_margin_start"
            android:text="@string/app_continue"
            android:textSize="@dimen/app_new_request_continue_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/occurrenceIntroSteps" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/occurrenceIntroCancel"
            style="@style/Widget.FIXA.App.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/app_new_request_cancel_height"
            android:layout_marginTop="@dimen/app_new_request_cancel_margin_top"
            android:text="@string/app_cancel"
            android:textColor="@color/app_primary_deep"
            android:textSize="@dimen/app_new_request_cancel_text_size"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/occurrenceIntroContinue" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
