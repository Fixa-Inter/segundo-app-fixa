<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_ops_9a20d877fd"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:elevation="@dimen/ops_dp_2">

    <View
        android:id="@+id/inspectionEquipmentAccent"
        android:layout_width="13dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_ops_4e33a872e8"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/inspectionEquipmentCode"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_marginStart="30dp"
        android:layout_marginTop="25dp"
        android:layout_marginEnd="16dp"
        android:fontFamily="@font/poppins_semibold"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FIXA.Operations.ed72944a40"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/inspectionEquipmentStatus"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:layout_marginStart="30dp"
        android:fontFamily="@font/poppins_medium"
        android:gravity="start|center_vertical"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.FIXA.Operations.4ed059c75b"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/inspectionEquipmentCode" />
</androidx.constraintlayout.widget.ConstraintLayout>
