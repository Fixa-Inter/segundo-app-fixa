<?xml version="1.0" encoding="utf-8"?>
<!-- Campo dropdown do filtro: 40dp r=15 #4DDBE0EB, texto 400/12 @ x=17 (sem ícone no Figma) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/app_filter_field_height"
    android:background="@drawable/bg_app_field_soft">

    <AutoCompleteTextView
        android:id="@+id/actvFilterValue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:importantForAutofill="no"
        android:inputType="none"
        android:maxLines="1"
        android:paddingStart="@dimen/app_filter_field_padding_start"
        android:paddingEnd="@dimen/app_filter_field_padding_start"
        android:textAppearance="@style/TextAppearance.FIXA.App.Filter.Field"
        tools:text="Últimos 30 dias" />
</FrameLayout>
