<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextAppearance.FIXA.Onboarding.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/poppins_medium</item>
        <item name="android:fontFamily">@font/poppins_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/onboarding_primary</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textSize">@dimen/onboarding_title_text_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.FIXA.Onboarding.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/onboarding_body_text</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textScaleX">1.01</item>
        <item name="android:textSize">@dimen/onboarding_body_text_size</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.FIXA.Onboarding.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/poppins_regular</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textSize">@dimen/onboarding_button_text_size</item>
